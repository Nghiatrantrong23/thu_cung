# Copy into server/.env; never put real secrets into this example.
# transfer = bank/MoMo instructions with receptionist confirmation.
# sandbox remains isolated to explicitly opted-in test databases.
PAYMENT_MODE=transfer
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_BANK_NAME=
PAYMENT_MOMO_PHONE=
PAYMENT_MOMO_NAME=
# Optional: the actual receive link shared by YOUR wallet, not a fabricated URL.
# Without a receive link, MoMo shows phone, recipient, amount and transfer note.
PAYMENT_MOMO_RECEIVE_URL=
