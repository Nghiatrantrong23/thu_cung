{
    "name": "petcare-server",
    "version": "0.1.0",
    "description": "Backend API for pet care management system",
    "type": "module",
    "main": "src/server.js",
    "scripts": {
        "start": "node src/server.js",
        "dev": "node --watch src/server.js",
        "db:init": "node scripts/init-db.js",
        "db:migrate": "node scripts/migrate.js",
        "db:seed": "node scripts/seed.js",
        "db:demo": "node scripts/demo-scenarios.js",
        "db:demo-accounts": "node scripts/new-demo-accounts.js",
        "demo:start": "node scripts/start-demo.js",
        "db:reset": "node scripts/reset-db.js",
        "db:setup": "node scripts/init-db.js --seed",
        "test": "node --test test/*.test.js",
        "payments:prepare": "node scripts/prepare-payment-sandbox.js",
        "payments:sandbox": "node scripts/start-payment-sandbox.js"
    },
    "dependencies": {
        "bcrypt": "^5.1.1",
        "cookie-parser": "^1.4.6",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.19.2",
        "express-rate-limit": "^7.4.0",
        "jsonwebtoken": "^9.0.2",
        "pg": "^8.12.0",
        "qrcode": "^1.5.4",
        "zod": "^3.23.8"
    },
    "devDependencies": {},
    "engines": {
        "node": ">=18.0.0"
    }
}
