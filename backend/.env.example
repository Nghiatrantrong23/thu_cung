# ============================================
# Server Configuration
# ============================================
PORT=5000
NODE_ENV=development

# ============================================
# PostgreSQL Database
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petcare_dev
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_this_refresh_secret_too
JWT_REFRESH_EXPIRES_IN=7d

# ============================================
# CORS (Frontend URL)
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# Bcrypt
# ============================================
BCRYPT_ROUNDS=10

# Enable only after migration 007; online money simulation remains test-only.
BOOKING_DEPOSIT_ENABLED=false
